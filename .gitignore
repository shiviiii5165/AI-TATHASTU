# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/.next_dev*/
/.next_build*/
/.next_dist/
/.next_types/
/out/

# production
/build

# misc
.DS_Store
._*
*.pem
.idea/
/test-screenshots/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vendored agent/design skills (kept locally, not part of the app)
/.claude/
/.agents/
/.taste-skill/
/landing page /
/logo and app icon /

# python
__pycache__/

# Benchmark datasets (third-party resumes): never commit
/worker/Resumes PDF/
*.pdf
